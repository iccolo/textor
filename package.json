{
  "name": "textor",
  "displayName": "Textor",
  "description": "%extension.description%",
  "version": "0.0.3",
  "publisher": "iccolo",
  "icon": "icon.jpg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iccolo/textor"
  },
  "homepage": "https://github.com/iccolo/textor#readme",
  "bugs": {
    "url": "https://github.com/iccolo/textor/issues"
  },
  "keywords": [
    "json",
    "json format",
    "json minify",
    "base64",
    "base64 encode",
    "base64 decode",
    "url encode",
    "url decode",
    "unicode",
    "timestamp",
    "date",
    "escape",
    "unescape",
    "protobuf",
    "hex",
    "ascii",
    "sql",
    "sql format",
    "ip address",
    "converter",
    "transformer",
    "text tools",
    "formatter",
    "encoder",
    "decoder",
    "camelcase",
    "snakecase",
    "uppercase",
    "lowercase",
    "uuid",
    "password generator",
    "hmac",
    "sha256"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onView:textor.sidebarView"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "textor",
          "title": "Textor",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "textor": [
        {
          "type": "webview",
          "id": "textor.sidebarView",
          "name": "%view.tools.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "textor.smartTransform",
        "title": "%command.smartTransform.title%"
      },
      {
        "command": "textor.openPanel",
        "title": "%command.openPanel.title%"
      },
      {
        "command": "textor.base64Encode",
        "title": "%command.base64Encode.title%"
      },
      {
        "command": "textor.base64Decode",
        "title": "%command.base64Decode.title%"
      },
      {
        "command": "textor.jsonFormat",
        "title": "%command.jsonFormat.title%"
      },
      {
        "command": "textor.jsonMinify",
        "title": "%command.jsonMinify.title%"
      },
      {
        "command": "textor.urlEncode",
        "title": "%command.urlEncode.title%"
      },
      {
        "command": "textor.urlDecode",
        "title": "%command.urlDecode.title%"
      },
      {
        "command": "textor.escape",
        "title": "%command.escape.title%"
      },
      {
        "command": "textor.unescape",
        "title": "%command.unescape.title%"
      },
      {
        "command": "textor.unicodeEncode",
        "title": "%command.unicodeEncode.title%"
      },
      {
        "command": "textor.unicodeDecode",
        "title": "%command.unicodeDecode.title%"
      },
      {
        "command": "textor.timestampToDate",
        "title": "%command.timestampToDate.title%"
      },
      {
        "command": "textor.dateToTimestamp",
        "title": "%command.dateToTimestamp.title%"
      },
      {
        "command": "textor.ipToInt",
        "title": "%command.ipToInt.title%"
      },
      {
        "command": "textor.intToIp",
        "title": "%command.intToIp.title%"
      },
      {
        "command": "textor.sqlFormat",
        "title": "%command.sqlFormat.title%"
      },
      {
        "command": "textor.sqlMinify",
        "title": "%command.sqlMinify.title%"
      },
      {
        "command": "textor.toUpperCase",
        "title": "%command.toUpperCase.title%"
      },
      {
        "command": "textor.toLowerCase",
        "title": "%command.toLowerCase.title%"
      },
      {
        "command": "textor.toTitleCase",
        "title": "%command.toTitleCase.title%"
      },
      {
        "command": "textor.toCamelCase",
        "title": "%command.toCamelCase.title%"
      },
      {
        "command": "textor.toSnakeCase",
        "title": "%command.toSnakeCase.title%"
      },
      {
        "command": "textor.hexToProtobuf",
        "title": "%command.hexToProtobuf.title%"
      },
      {
        "command": "textor.protobufToHex",
        "title": "%command.protobufToHex.title%"
      },
      {
        "command": "textor.asciiToHex",
        "title": "%command.asciiToHex.title%"
      },
      {
        "command": "textor.hexToAscii",
        "title": "%command.hexToAscii.title%"
      },
      {
        "command": "textor.protoFormat",
        "title": "%command.protoFormat.title%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "textor.smartTransform",
          "when": "editorHasSelection",
          "group": "textor@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "textor.smartTransform",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.1",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
